    "motion": "^14.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "use-lanyard": "^2.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
